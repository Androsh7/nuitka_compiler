ARG ARCHITECTURE="x86_64"
FROM quay.io/pypa/manylinux_2_28_${ARCHITECTURE}:latest

WORKDIR /src

# Install libraries
RUN yum -y update \
&& yum -y install \
gcc \
gcc-c++ \
make \
git \
curl \
patchelf \
perl \
perl-core \
perl-IPC-Cmd \
pkgconfig \
binutils \
which \
findutils \
file \
patch \
diffutils \
zlib-devel \
bzip2-devel \
xz-devel \
libffi-devel \
openssl-devel \
sqlite-devel \
readline-devel \
ncurses-devel \
gdbm-devel \
expat-devel \
libuuid-devel \
ca-certificates \
&& update-ca-trust \
&& yum -y clean all \
&& rm -rf /var/cache/yum

# Build OpenSSL from source
ARG OPENSSL_VERSION="3.0.18"
# Clone cpython before OpenSSL build
ARG PYTHON_VERSION="3.13"
RUN git clone --branch ${PYTHON_VERSION} --single-branch --depth 1 https://github.com/python/cpython.git \
&& curl -fsSLO "https://www.openssl.org/source/openssl-${OPENSSL_VERSION}.tar.gz" \
&& tar -xzf "openssl-${OPENSSL_VERSION}.tar.gz" \
&& cd "openssl-${OPENSSL_VERSION}" \
&& ./config \
--prefix=/opt/openssl \
--openssldir=/opt/openssl \
shared zlib \
&& make -j"$(nproc)" \
&& make install_sw \
&& { echo "/opt/openssl/lib64"; echo "/opt/openssl/lib"; } > /etc/ld.so.conf.d/openssl.conf \
&& ldconfig \
&& /opt/openssl/bin/openssl version -a \
&& rm -rf /src/openssl*

# Set OpenSSL environment variables
ENV OPENSSL_ROOT=/opt/openssl
ENV PATH="${OPENSSL_ROOT}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${OPENSSL_ROOT}/lib64:${OPENSSL_ROOT}/lib:${LD_LIBRARY_PATH}"

# Build Python from source
RUN cd cpython \
&& export CPPFLAGS="-I${OPENSSL_ROOT}/include" \
&& OPENSSL_LIBDIR="" \
&& if [ -d "${OPENSSL_ROOT}/lib64" ] && ls "${OPENSSL_ROOT}/lib64"/libssl.so* >/dev/null 2>&1; then \
OPENSSL_LIBDIR="${OPENSSL_ROOT}/lib64"; \
else \
OPENSSL_LIBDIR="${OPENSSL_ROOT}/lib"; \
fi \
&& export LDFLAGS="-L${OPENSSL_LIBDIR} -Wl,-rpath,${OPENSSL_LIBDIR}" \
&& export CFLAGS="-O2 -pipe" \
&& export CXXFLAGS="-O2 -pipe" \
&& ./configure \
--prefix="/opt/python-${PYTHON_VERSION}" \
--disable-shared \
--with-ensurepip=install \
--with-openssl="${OPENSSL_ROOT}" \
--with-openssl-rpath=auto \
--enable-optimizations \
--with-lto \
&& make -j"$(nproc)" profile-opt \
&& make install \
&& rm -rf /src/*

ENV PATH=/opt/python-${PYTHON_VERSION}/bin:${PATH}

# Update pip, setuptools, wheel, and install/test nuitka
RUN python3 -m pip install --upgrade pip setuptools wheel \ 
&& python3 -m pip install nuitka zstandard \
# Compile a test file to verify nuitka works
&& echo 'print("Nuitka is working!")' > test_nuitka.py \
&& python3 -m nuitka --standalone --onefile --output-file=/src/test_nuitka_compiled.bin test_nuitka.py \
&& chmod +x /src/test_nuitka_compiled.bin \
&& /src/test_nuitka_compiled.bin \
&& rm -rf /src/*